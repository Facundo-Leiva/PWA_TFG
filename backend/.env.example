DATABASE_URL=
JWT_SECRET=
PORT=3000

# URL pública del backend, sin barra final.
# Desarrollo: http://localhost:3000
# Producción: URL asignada por Railway.
PUBLIC_API_URL=

# Carpeta donde se guardan las imágenes.
# Desarrollo: ./uploads
# Railway con Volume: /app/uploads
UPLOAD_DIR=./uploads

# Orígenes autorizados para acceder al backend desde el navegador.
# Separar varios valores con comas y no agregar barra final.
# Producción: reemplazar por el dominio principal de Vercel.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
